# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Example: OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Admin credentials — a path to the service account JSON, or the JSON
# itself. Keep the file OUTSIDE any app bundle directory (see /secrets).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gymapp-firebase-adminsdk.json
# Alternatively, base64 the whole JSON (handy for Railway/Heroku env vars):
# FIREBASE_SERVICE_ACCOUNT_B64=

# CORS. Comma-separated origins. Defaults to localhost dev origins when unset —
# set this explicitly in production. "*" disables credentialed requests.
CORS_ALLOWED_ORIGINS=https://your-web-app.vercel.app

# ---------------------------------------------------------------------------
# AI access limits
# ---------------------------------------------------------------------------

# Free-tier AI requests per user per day (chat + monthly analysis).
AI_FREE_DAILY_LIMIT=5

# Daily limit granted when an access request is approved without a set number.
AI_GRANTED_DAILY_LIMIT=50

# Emails allowed to review access requests and content reports. Comma-separated.
# A Firebase custom claim of `admin: true` works too, and is preferred.
ADMIN_EMAILS=you@example.com

# Moderation model used to screen chat input before it reaches the coach.
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ---------------------------------------------------------------------------
# Mobile app (frontend/.env) — every EXPO_PUBLIC_* value is embedded in the
# shipped bundle and is therefore public. Never put a secret here.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=https://your-api.up.railway.app

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Required by App Store review — must be publicly reachable before you submit.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-site.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-site.com/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-site.com
