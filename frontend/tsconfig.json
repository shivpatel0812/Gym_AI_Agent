{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Everything else — module, moduleResolution, jsx, lib, target — comes from
    // expo/tsconfig.base. Overriding them here is what broke the build on the
    // SDK 57 upgrade: the base now sets moduleResolution "bundler" plus the
    // "react-native" custom condition, which a "node" override invalidates.
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
