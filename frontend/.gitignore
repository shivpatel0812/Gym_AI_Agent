# Native projects are generated by `expo prebuild` (Continuous Native
# Generation) — EAS Build regenerates them from app.config.js on every build.
# Committing them means the config and the native project can silently diverge.
/ios
/android

# Expo local state (machine-specific device history, dev server settings)
.expo/

node_modules/
dist/
web-build/

# Local env — push to EAS with `eas secret:push --env-file .env`
.env
.env.local
*.log
